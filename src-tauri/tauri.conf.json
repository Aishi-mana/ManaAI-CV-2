{

  "$schema": "https://schema.tauri.app/config/2",

  "productName": "Mana",

  "version": "0.1.0",

  "identifier": "com.mana.companion",

  "build": {

    "beforeDevCommand": "npm run dev",

    "devUrl": "http://localhost:1430",

    "beforeBuildCommand": "npm run build",

    "frontendDist": "../dist"

  },

  "app": {

    "windows": [

      {

        "title": "Mana",

        "width": 1100,

        "height": 760,

        "minWidth": 820,

        "minHeight": 560

      }

    ],

    "security": {

      "csp": null

    }

  },

  "bundle": {

    "active": true,

    "targets": "all",

    "resources": {

      "../assets/avatar/": "assets/avatar/",

      "../scripts/image_job.py": "scripts/image_job.py",
      "../scripts/generated_outfit.py": "scripts/generated_outfit.py",
      "../scripts/garment_only.py": "scripts/garment_only.py",
      "../scripts/outfit_quality.py": "scripts/outfit_quality.py",
      "../scripts/clothing_fit.py": "scripts/clothing_fit.py",
      "../scripts/aligned_outfit.py": "scripts/aligned_outfit.py",
      "../scripts/intact_outfit.py": "scripts/intact_outfit.py",
      "../scripts/clothing_extract.py": "scripts/clothing_extract.py",
      "../scripts/clothing_refine.py": "scripts/clothing_refine.py",
      "../scripts/clothing_edges.py": "scripts/clothing_edges.py",
      "../scripts/clothing_footwear.py": "scripts/clothing_footwear.py",

      "../scripts/qwen_image.py": "scripts/qwen_image.py",

      "../scripts/singing_job.py": "scripts/singing_job.py",
      "../scripts/cover_genre.py": "scripts/cover_genre.py",
      "../scripts/piano_transcription.py": "scripts/piano_transcription.py",
      "../scripts/portable_backup.py": "scripts/portable_backup.py",
      "../scripts/band_mix.py": "scripts/band_mix.py",
      "../scripts/piano_arrangement.py": "scripts/piano_arrangement.py",
      "../scripts/guitar_transcription.py": "scripts/guitar_transcription.py",
      "../scripts/guitar_arrangement.py": "scripts/guitar_arrangement.py",
      "../scripts/source_band.py": "scripts/source_band.py",
      "../scripts/music_beats.py": "scripts/music_beats.py",
      "../scripts/trained_voice.py": "scripts/trained_voice.py",
      "../scripts/trained_chat_worker.py": "scripts/trained_chat_worker.py",

      "../scripts/cover_lead.py": "scripts/cover_lead.py",

      "../scripts/singing_pitch.py": "scripts/singing_pitch.py",

      "../scripts/arrangement_job.py": "scripts/arrangement_job.py",

      "../scripts/arrangement_band.py": "scripts/arrangement_band.py",

      "../scripts/arrangement_replacement.py": "scripts/arrangement_replacement.py",

      "../scripts/bass_replacement.py": "scripts/bass_replacement.py",

      "../scripts/sax_replacement.py": "scripts/sax_replacement.py",

      "../scripts/strings_replacement.py": "scripts/strings_replacement.py",

      "../scripts/flute_replacement.py": "scripts/flute_replacement.py",

      "../scripts/violin_replacement.py": "scripts/violin_replacement.py",

      "../scripts/vocal_melody.py": "scripts/vocal_melody.py",

      "../scripts/ocarina_replacement.py": "scripts/ocarina_replacement.py",

      "../scripts/electric_piano_replacement.py": "scripts/electric_piano_replacement.py",

      "../scripts/synth_lead_replacement.py": "scripts/synth_lead_replacement.py",

      "../scripts/vocal_harmony.py": "scripts/vocal_harmony.py",

      "../scripts/drum_replacement.py": "scripts/drum_replacement.py",

      "../scripts/fine_separator.py": "scripts/fine_separator.py",

      "../scripts/optional_separators.py": "scripts/optional_separators.py",

      "../scripts/original_song_job.py": "scripts/original_song_job.py",

      "../scripts/builder_notes.py": "scripts/builder_notes.py"

    },

    "icon": [

      "icons/32x32.png",

      "icons/128x128.png",

      "icons/128x128@2x.png",

      "icons/icon.ico"

    ]

  }

}
